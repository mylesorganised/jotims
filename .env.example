# Copy to .env.local for local overrides. Locally you need NONE of these:
# without DATABASE_URL the app uses an embedded database in ./.data, and
# uploads are saved to ./.data/uploads.

# --- Database (set automatically when you add Neon Postgres on Vercel) ---
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# --- File uploads (set automatically when you connect a Vercel Blob store) ---
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Blob stores are private by default. Only set this if you made a PUBLIC store.
# BLOB_ACCESS=public

# --- First leader account (used once, when there are no leaders yet) ---
# ADMIN_USERNAME=akela
# ADMIN_PASSWORD=choose-a-long-password
# ADMIN_NAME=Akela

# --- Signs the login cookies. Generate one with: openssl rand -base64 32 ---
# SESSION_SECRET=

# --- AI helper (optional). Without a key the helper button is hidden. ---
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=z-ai/glm-5.3-flash
# Only set this if requests fail because no privacy-respecting provider is available:
# OPENROUTER_ALLOW_DATA_COLLECTION=true
